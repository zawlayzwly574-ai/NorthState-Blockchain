{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/blockchain-hub run build",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/admin-panel",
      "destination": "https://north-state-blockchain-admin-panel.vercel.app"
    },
    {
      "source": "/admin-panel/:path*",
      "destination": "https://north-state-blockchain-admin-panel.vercel.app/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}